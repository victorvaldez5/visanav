{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "api/Dockerfile"
  },
  "deploy": {
    "startCommand": "python manage.py purge_expired_conversations",
    "cronSchedule": "0 7 * * *",
    "numReplicas": 1,
    "restartPolicyType": "NEVER"
  }
}
