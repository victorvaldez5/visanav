# Frontend build-time configuration (Vite).
# VITE_* variables are read at BUILD time and baked into the bundle.
#
# VITE_API_BASE_URL — absolute base URL of the Django API, INCLUDING the /api prefix.
#   • Local dev:  leave unset. vite.config.ts proxies /api → http://api:8000.
#   • Production (Cloudflare Pages, app.visanav.org): point at the API subdomain:
#       VITE_API_BASE_URL=https://api.visanav.org/api
#     Set it in the Cloudflare Pages project's build environment variables.
#     (Before the api.visanav.org custom domain is live, the raw Railway URL
#      https://api-frosty-rain-5363-production.up.railway.app/api also works.)
VITE_API_BASE_URL=

# VITE_TURNSTILE_SITE_KEY — Cloudflare Turnstile site key (public) for the bot
#   check on the login/registration forms. Defaults to Cloudflare's always-pass
#   TEST key so the widget renders with no config. Set the real key in prod,
#   paired with TURNSTILE_SECRET_KEY on the API (which verifies the token).
VITE_TURNSTILE_SITE_KEY=
