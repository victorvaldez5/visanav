# ─────────────────────────────────────────────────────────────────────────────
# VisaNav environment configuration
#
# Single home for environment variables across the whole project
# (api, database, frontend, scraper, data scripts).
#
#   1. Copy this file:   cp config/.env.example config/.env
#   2. Fill in the secrets marked "CHANGE ME".
#
# config/.env is gitignored; this file (config/.env.example) is committed and
# documents every variable. Readers wired to config/.env:
#   • docker-compose.yml         (env_file, all services)
#   • api/api_project/base.py    (Django, load_dotenv)
#   • scrapers/…/settings.py     (Scrapy, load_dotenv)
#   • data/scripts/ingest.py     (optional, for --upsert)
# ─────────────────────────────────────────────────────────────────────────────

# ── Django / API ─────────────────────────────────────────────────────────────
# Settings module to load: api_project.dev (default) or api_project.prod
DJANGO_SETTINGS_MODULE=api_project.dev
# CHANGE ME for anything but local dev.
DJANGO_SECRET_KEY=dev-secret-key-change-me
# Comma-separated (used by prod settings).
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Public URL of the frontend (used for email links, CORS).
FRONTEND_URL=http://localhost:3000

# Production hardening (safe to leave unset in dev):
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0

# ── Database (Postgres) ──────────────────────────────────────────────────────
POSTGRES_DB=visanav
POSTGRES_USER=visanav
POSTGRES_PASSWORD=change-me-in-dev
# Use "db" under docker-compose; "localhost" when running Django natively.
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Prod-only tuning:
POSTGRES_SSLMODE=prefer
PG_CONN_MAX_AGE=60

# ── Public-resources directory (seeding) ─────────────────────────────────────
# When SEED_DIRECTORY=1, api/entrypoint.sh seeds the directory on boot
# (load_resources → extract_ra_orgs → extract_probono → extract_ra_reps;
# idempotent, non-fatal). Leave unset for normal boots and seed manually instead.
SEED_DIRECTORY=
# Country whose curated data/ YAML load_resources ingests (default: us).
SEED_COUNTRY=us
# Override where the curated corpus lives; auto-detected otherwise (host repo or
# /app/data in the container).
DATA_DIR=

# ── LLM / chat agent ─────────────────────────────────────────────────────────
# Chat provider: "anthropic" (default) or "openai".
LLM_PROVIDER=anthropic
# Override the per-provider default model (optional).
CHAT_MODEL=
# CHANGE ME — required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# CHANGE ME — required when LLM_PROVIDER=openai.
OPEN_AI_API_KEY=
# Chat guardrails (optional; defaults live in code).
CHAT_MAX_MESSAGE_CHARS=
CHAT_RATE_LIMIT_PER_MINUTE=

# ── Conversation privacy: retention + at-rest encryption ─────────────────────
# Auto-delete windows (days), enforced by:
#   python manage.py purge_expired_conversations
# Run it on a schedule (Railway cron service or a scheduled GitHub Action).
# Retention is measured from the last message and refreshed each turn; 0 (or
# blank) disables auto-expiry for that class. Signed-in chats are kept instead
# of expiring only when the user opts in (Profile.retain_history).
CONVERSATION_ANON_RETENTION_DAYS=7
CONVERSATION_USER_RETENTION_DAYS=30
# Fernet key(s) encrypting conversation content at rest. Comma-separated: the
# first encrypts, all are tried on decrypt (prepend a new key to rotate). REQUIRED
# in prod (api_project.prod refuses the public dev default). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank in dev/CI; a throwaway key is derived from the dev SECRET_KEY, so
# no key material is committed. Required in prod (api_project.prod won't boot without it).
CONVERSATION_ENCRYPTION_KEYS=

# ── Vector store / embeddings (pgvector + Voyage AI) ─────────────────────────
# Retrieval lives in the app's Postgres via pgvector; embeddings are generated by
# Voyage on both ingest and query (Pinecone, which embedded server-side, is gone).
# CHANGE ME — required for semantic search and data ingestion.
VOYAGE_API_KEY=
# Embedding provider + model. voyage-3 and voyage-law-2 are both 1024-dim, so
# EMBEDDING_MODEL can be swapped between them with only a re-embed (no migration).
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3
# Fixed to the KnowledgeChunk.embedding column type. Changing it needs a schema
# migration + full re-embed, so leave it at 1024 unless you migrate the column.
EMBEDDING_DIM=1024
# Country whose curated corpus the chat agent searches (KnowledgeChunk.country).
# `manage.py ingest us` writes country "us"; a mismatch returns nothing.
KNOWLEDGE_COUNTRY=us
# Where the ingest command reads curated Markdown from. Defaults to the repo's
# data/countries; only override if your checkout layout differs.
KNOWLEDGE_DATA_DIR=

# ── Email (Mailtrap) ─────────────────────────────────────────────────────────
MAILTRAP_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@visanav.app
EMAIL_PORT=587
EMAIL_USE_TLS=true

# ── Cloudflare Turnstile (bot protection on the marketing NGO intake form) ────
# Server-side secret key. Empty = verification disabled (dev/CI/tests pass).
# In prod set the real secret; it pairs with PUBLIC_TURNSTILE_SITE_KEY baked
# into the marketing site (marketing/.env). Cloudflare's always-pass test pair:
#   site   1x00000000000000000000AA
#   secret 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# ── Scraper (uscis_scraper) ──────────────────────────────────────────────────
# LOCAL_TEST=true writes scraped output locally; false uploads to Cloudflare R2
# (see the object-storage block below).
LOCAL_TEST=true
LOCAL_FILES=output
LOCAL_SIZE_LIMIT_MB=10
LOG_LEVEL=INFO

# ── Object storage (Cloudflare R2) ───────────────────────────────────────────
# Production raw-data sink for the scraper (HTML, PDFs, JSONL, manifest).
# Only used when LOCAL_TEST=false; in CI these come from GitHub Secrets.
# CHANGE ME — R2 bucket name and S3 API credentials (an R2 API token).
R2_BUCKET=
# R2 S3 endpoint, e.g. https://<account_id>.r2.cloudflarestorage.com
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 uses the sentinel region "auto".
AWS_REGION_NAME=auto

# ── Docker build (compose interpolation) ─────────────────────────────────────
# Image build target: development or production.
BUILD_TARGET=development
# Image tag used by docker-compose.
TAG=latest
