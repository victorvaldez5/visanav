{
  // Deploys the built ./dist as static assets on Cloudflare (www.visanav.org),
  // mirroring frontend/wrangler.jsonc. Build first (`npm run build`), then
  // `wrangler deploy` uploads ./dist — this config keeps deploys deterministic.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visanav-www",
  "compatibility_date": "2026-09-14",
  // Attach www.visanav.org as a Cloudflare-managed custom domain (DNS + cert).
  // The zone's stale `www` A records (a domain-parking lander) must be removed
  // for this to bind; Cloudflare offers to replace them on the first deploy.
  "routes": [{ "pattern": "www.visanav.org", "custom_domain": true }],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "assets": {
    "directory": "./dist",
    // Multi-page static site: serve the generated 404.html for unknown paths.
    "not_found_handling": "404-page"
  }
}
