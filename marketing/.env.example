# Local dev overrides. Production defaults live in src/config.ts, so the site
# builds with no .env at all. Copy to .env to point at your local services.
#
#   PUBLIC_APP_URL  — where "Start free chat" and directory links go (the SPA)
#   PUBLIC_API_URL  — base URL the NGO intake form POSTs to (the Django API)

PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# Cloudflare Turnstile site key (public). Defaults to Cloudflare's always-pass
# test key; set the real key in prod, paired with TURNSTILE_SECRET_KEY on the API.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
