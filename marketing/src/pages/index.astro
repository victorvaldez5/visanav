---
import Base from "../layouts/Base.astro";
import { APP_URL } from "../config";
import orgs from "../data/organizations.json";

const total = orgs.length;
const proBono = orgs.filter((o) => o.proBono).length;
const states = new Set(orgs.map((o) => o.state).filter(Boolean)).size;

const steps = [
  {
    title: "Ask in your own words",
    body: "Describe your situation in plain language — no forms, no jargon, no account required.",
  },
  {
    title: "Get clear answers with sources",
    body: "VisaNav explains your options and points to official USCIS and government sources you can verify.",
  },
  {
    title: "Find free help near you",
    body: "Connect to recognized nonprofits and pro-bono providers in your state — not to anyone trying to sell you something.",
  },
];

const trust = [
  "100% free",
  "No account needed",
  "Encrypted, never sold",
  "Not a law firm",
];

const badges = ["Beta", "Free public tool", "Not affiliated with USCIS or ICE"];

// The privacy promises below map to real features: anonymous chat (no account),
// conversations encrypted at rest with retention limits, and account/data
// erasure (right to delete). Keep the copy in step with what the app does.
const privacy = [
  {
    title: "Anonymous by default",
    body: "No account required. Ask your questions without signing up or telling us who you are.",
  },
  {
    title: "Encrypted, and yours to delete",
    body: "Your conversations are encrypted and kept only as long as needed — and you can delete your account and data whenever you want.",
  },
  {
    title: "Never sold or shared",
    body: "We don't sell your information or use it for advertising. Your questions are used only to answer you — nothing else.",
  },
];

const btnPrimary =
  "inline-block bg-primary px-5 py-3 text-base font-semibold text-primary-foreground shadow-sm transition-opacity hover:opacity-90";
const btnSecondary =
  "inline-block border border-border bg-surface px-5 py-3 text-base font-semibold text-foreground shadow-sm transition-colors hover:bg-surface-muted";
---

<Base
  title="VisaNav — Free, private immigration help"
  description="A free public tool, now in beta, that explains your immigration options in plain language and connects you to recognized nonprofits and pro-bono legal help near you. Anonymous, encrypted, no account, no cost, no data sold."
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-surface-muted to-transparent"
    >
    </div>
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
      <div class="max-w-2xl">
        <h1 class="text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
          Immigration is confusing. Getting help shouldn't be.
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
          VisaNav answers your immigration questions in plain language, cites
          official sources, and points you to trustworthy free and low-cost help
          near you. Ask anonymously — no account, no cost, and your questions are
          encrypted and never sold.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={APP_URL} class={btnPrimary}>Start a free chat</a>
          <a href="/directory" class={btnSecondary}>Find help near you</a>
        </div>

        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted-foreground">
          {
            trust.map((t) => (
              <li class="flex items-center gap-2">
                <svg class="h-4 w-4 text-link" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7 7a1 1 0 01-1.4 0l-3-3a1 1 0 011.4-1.4L9 11.6l6.3-6.3a1 1 0 011.4 0z" clip-rule="evenodd" />
                </svg>
                {t}
              </li>
            ))
          }
        </ul>

        <ul class="mt-4 flex flex-wrap gap-2">
          {
            badges.map((b) => (
              <li
                class:list={[
                  "border border-vn-orange-200 bg-vn-orange-50 px-2.5 py-1 text-xs font-semibold text-vn-orange-800",
                  b === "Beta" && "uppercase tracking-wide",
                ]}
              >
                {b}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h2 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
      How VisaNav helps
    </h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      {
        steps.map((s, i) => (
          <div class="border border-border bg-surface p-6 shadow-sm">
            <div class="grid h-9 w-9 place-items-center bg-primary text-sm font-bold text-primary-foreground">
              {i + 1}
            </div>
            <h3 class="mt-4 text-lg font-semibold text-foreground">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{s.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Privacy -->
  <section class="border-t border-border">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
        Your privacy comes first
      </h2>
      <p class="mt-3 max-w-2xl text-muted-foreground">
        Immigration questions are personal. VisaNav is built so you can ask
        freely — without an account, and without wondering where your
        information goes.
      </p>
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {
          privacy.map((p) => (
            <div class="border border-border bg-surface p-6 shadow-sm">
              <h3 class="text-lg font-semibold text-foreground">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                {p.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Directory teaser -->
  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <div class="border border-border bg-surface-muted p-8 shadow-sm sm:p-10">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="max-w-xl">
          <h2 class="text-2xl font-bold tracking-tight text-foreground">
            A directory of real, trustworthy help
          </h2>
          <p class="mt-3 text-muted-foreground">
            Browse <strong class="text-foreground">{total.toLocaleString()}</strong> nonprofit and
            pro-bono organizations — including <strong class="text-foreground">{proBono}</strong>{" "}
            pro-bono legal providers — across <strong class="text-foreground">{states}</strong> states,
            drawn from official DOJ/EOIR recognized-organization data.
          </p>
        </div>
        <a href="/directory" class:list={["shrink-0", btnPrimary]}>Browse the directory</a>
      </div>
    </div>
  </section>

  <!-- For organizations -->
  <section class="border-y border-border bg-surface-muted">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="max-w-xl">
          <h2 class="text-2xl font-bold tracking-tight text-foreground">
            Do you run an organization that helps immigrants?
          </h2>
          <p class="mt-3 text-muted-foreground">
            Ask to be listed as a trusted resource, or partner with us to offer
            VisaNav to the people you serve. Every request is reviewed before
            it's listed.
          </p>
        </div>
        <a href="/partners" class:list={["shrink-0", btnSecondary]}>Request to be included</a>
      </div>
    </div>
  </section>
</Base>
