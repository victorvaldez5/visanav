---
import Base from "../layouts/Base.astro";
import { orgAppLink } from "../config";
import orgs from "../data/organizations.json";

const total = orgs.length;
const proBono = orgs.filter((o) => o.proBono).length;
const states = Array.from(new Set(orgs.map((o) => o.state).filter(Boolean))).sort();
---

<Base
  title="Find free immigration help near you — VisaNav directory"
  description="Search a directory of nonprofit and pro-bono immigration organizations across the U.S., drawn from official DOJ/EOIR recognized-organization data. Free to browse, no account needed."
  canonicalPath="/directory"
>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
      Find trustworthy immigration help
    </h1>
    <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-300">
      {total.toLocaleString()} nonprofit and pro-bono organizations — including
      {proBono} pro-bono legal providers — from official DOJ/EOIR recognized-organization
      data. Free to browse. Being listed here is not an endorsement; always
      verify an organization before sharing personal details.
    </p>

    <!-- Filters -->
    <div class="mt-8 grid gap-3 sm:grid-cols-[1fr_auto_auto] sm:items-end">
      <div>
        <label for="q" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Search by name or city</label>
        <input
          id="q"
          type="search"
          autocomplete="off"
          placeholder="e.g. Catholic Charities, Houston…"
          class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
        />
      </div>
      <div>
        <label for="state" class="block text-sm font-medium text-slate-700 dark:text-slate-300">State</label>
        <select
          id="state"
          class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 sm:w-40 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
        >
          <option value="">All states</option>
          {states.map((s) => <option value={s}>{s}</option>)}
        </select>
      </div>
      <label class="flex items-center gap-2 pb-2 text-sm font-medium text-slate-700 dark:text-slate-300">
        <input id="probono" type="checkbox" class="h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
        Pro-bono only
      </label>
    </div>

    <p id="count" class="mt-6 text-sm text-slate-500 dark:text-slate-400" aria-live="polite">
      Showing {total.toLocaleString()} organizations
    </p>

    <!-- Results -->
    <ul id="results" class="mt-4 grid gap-4 sm:grid-cols-2">
      {
        orgs.map((o) => (
          <li
            class="org-card rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/40"
            data-name={o.name.toLowerCase()}
            data-city={(o.city || "").toLowerCase()}
            data-state={o.state}
            data-probono={o.proBono ? "1" : "0"}
          >
            <div class="flex items-start justify-between gap-3">
              <h2 class="font-semibold text-slate-900 dark:text-white">{o.name}</h2>
              {o.proBono && (
                <span class="shrink-0 rounded-full bg-brand-100 px-2 py-0.5 text-xs font-medium text-brand-800 dark:bg-brand-900/40 dark:text-brand-200">
                  Pro bono
                </span>
              )}
            </div>

            {(o.city || o.state) && (
              <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                {[o.city, o.state].filter(Boolean).join(", ")}
              </p>
            )}

            <dl class="mt-3 space-y-1 text-sm text-slate-600 dark:text-slate-300">
              {o.phone && (
                <div class="flex gap-2">
                  <dt class="sr-only">Phone</dt>
                  <dd><a href={`tel:${o.phone.replace(/[^\d+]/g, "")}`} class="hover:text-brand-700 dark:hover:text-brand-300">{o.phone}</a></dd>
                </div>
              )}
              {o.website && (
                <div class="flex gap-2">
                  <dt class="sr-only">Website</dt>
                  <dd class="truncate">
                    <a href={o.website} target="_blank" rel="noopener noreferrer nofollow" class="text-brand-700 hover:underline dark:text-brand-300">
                      Visit website
                    </a>
                  </dd>
                </div>
              )}
            </dl>

            <a
              href={orgAppLink(o.id)}
              class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:gap-2 dark:text-brand-300"
            >
              Ask VisaNav about this org
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p id="empty" hidden class="mt-10 text-center text-slate-500 dark:text-slate-400">
      No organizations match your search. Try a different state or clear the filters.
    </p>
  </section>
</Base>

<script>
  const q = document.getElementById("q") as HTMLInputElement;
  const state = document.getElementById("state") as HTMLSelectElement;
  const probono = document.getElementById("probono") as HTMLInputElement;
  const count = document.getElementById("count") as HTMLElement;
  const empty = document.getElementById("empty") as HTMLElement;
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".org-card"));
  const nf = new Intl.NumberFormat();

  function apply() {
    const term = q.value.trim().toLowerCase();
    const st = state.value;
    const pb = probono.checked;
    let visible = 0;

    for (const card of cards) {
      const matchesTerm =
        !term ||
        (card.dataset.name ?? "").includes(term) ||
        (card.dataset.city ?? "").includes(term);
      const matchesState = !st || card.dataset.state === st;
      const matchesPb = !pb || card.dataset.probono === "1";
      const show = matchesTerm && matchesState && matchesPb;
      card.hidden = !show;
      if (show) visible++;
    }

    count.textContent = `Showing ${nf.format(visible)} organization${visible === 1 ? "" : "s"}`;
    empty.hidden = visible !== 0;
  }

  let raf = 0;
  const schedule = () => {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(apply);
  };
  q.addEventListener("input", schedule);
  state.addEventListener("change", apply);
  probono.addEventListener("change", apply);
</script>
