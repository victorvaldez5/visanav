---
import Base from "../layouts/Base.astro";
import Eyebrow from "../components/Eyebrow.astro";
import { orgAppLink } from "../config";
import orgs from "../data/organizations.json";

const total = orgs.length;
const proBono = orgs.filter((o) => o.proBono).length;
const states = Array.from(new Set(orgs.map((o) => o.state).filter(Boolean))).sort();
---

<Base
  title="Find free immigration help near you — VisaNav directory"
  description="Search a directory of nonprofit and pro-bono immigration organizations across the U.S., drawn from official DOJ/EOIR recognized-organization data. Free to browse, no account needed."
  canonicalPath="/directory"
>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <Eyebrow items={["FREE TO BROWSE", "NO ACCOUNT NEEDED", "DOJ/EOIR DATA"]} />

    <h1 class="mt-5 text-4xl font-bold text-foreground">
      Find trustworthy immigration help
    </h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
      {total.toLocaleString()} nonprofit and pro-bono organizations — including{" "}
      {proBono} pro-bono legal providers — from official DOJ/EOIR recognized-organization
      data. Free to browse. Being listed here is not an endorsement; always
      verify an organization before sharing personal details.
    </p>

    <!-- Filters -->
    <div class="mt-8 grid gap-4 sm:grid-cols-[1fr_auto_auto] sm:items-end">
      <div>
        <label for="q" class="block text-sm font-medium text-foreground">Search by name or city</label>
        <div class="vn-field mt-2 flex h-10 items-center px-3">
          <svg class="h-4 w-4 shrink-0 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            id="q"
            type="search"
            autocomplete="off"
            placeholder="e.g. Catholic Charities, Houston…"
            class="ml-2 flex-1 border-none bg-transparent text-sm text-foreground outline-none placeholder:text-field-placeholder"
          />
        </div>
      </div>
      <div>
        <label for="state" class="block text-sm font-medium text-foreground">State</label>
        <select id="state" class="vn-field mt-2 h-10 px-3 text-sm sm:w-44">
          <option value="">All states</option>
          {states.map((s) => <option value={s}>{s}</option>)}
        </select>
      </div>
      <label class="flex items-center gap-2.5 pb-2 text-sm font-medium text-foreground">
        <input id="probono" type="checkbox" class="h-[18px] w-[18px] accent-vn-ocean-700" />
        Pro-bono only
      </label>
    </div>

    <p id="count" class="mt-7 scroll-mt-24 text-sm text-muted-foreground" aria-live="polite">
      Showing {total.toLocaleString()} organizations
    </p>

    <!-- Results -->
    <ul id="results" class="mt-4 grid gap-4 sm:grid-cols-2">
      {
        orgs.map((o) => (
          <li
            class="org-card vn-card p-5"
            data-name={o.name.toLowerCase()}
            data-city={(o.city || "").toLowerCase()}
            data-state={o.state}
            data-probono={o.proBono ? "1" : "0"}
          >
            <div class="flex items-start justify-between gap-3">
              <h2 class="text-lg font-bold leading-tight text-foreground">{o.name}</h2>
              {o.proBono && (
                <span class="vn-badge vn-badge-diamond h-[22px] shrink-0 px-4 text-xs">
                  Pro bono
                </span>
              )}
            </div>

            {(o.city || o.state) && (
              <p class="mt-1 text-sm text-muted-foreground">
                {[o.city, o.state].filter(Boolean).join(", ")}
              </p>
            )}

            <dl class="mt-3 flex flex-col gap-1.5 text-sm text-muted-foreground">
              {o.phone && (
                <div class="flex items-center gap-2">
                  <dt class="sr-only">Phone</dt>
                  <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="6" y="2" width="12" height="20" rx="2" fill="var(--vn-ocean-700)" />
                    <rect x="10" y="18" width="4" height="1.5" rx="0.75" fill="var(--vn-sunflower-500)" />
                  </svg>
                  <dd><a href={`tel:${o.phone.replace(/[^\d+]/g, "")}`} class="text-muted-foreground hover:text-link">{o.phone}</a></dd>
                </div>
              )}
              {o.website && (
                <div class="flex items-center gap-2">
                  <dt class="sr-only">Website</dt>
                  <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" fill="var(--vn-ocean-700)" />
                    <line x1="3" y1="12" x2="21" y2="12" stroke="var(--vn-sunflower-500)" stroke-width="1.5" />
                    <ellipse cx="12" cy="12" rx="4" ry="9" fill="none" stroke="var(--vn-sunflower-500)" stroke-width="1.5" />
                  </svg>
                  <dd class="min-w-0 truncate">
                    <a href={o.website} target="_blank" rel="noopener noreferrer nofollow" class="vn-link">
                      Visit website
                    </a>
                  </dd>
                </div>
              )}
            </dl>

            <a
              href={orgAppLink(o.id)}
              class="vn-link mt-3.5 inline-flex items-center gap-1.5 text-sm font-semibold"
            >
              Ask VisaNav about this org
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p id="empty" hidden class="mt-10 text-center text-muted-foreground">
      No organizations match your search. Try a different state or clear the filters.
    </p>

    <!-- Pagination. Hidden until the script activates it, so with JS disabled the
         full server-rendered list stays visible (no dead controls). -->
    <nav
      id="pager"
      hidden
      aria-label="Directory pages"
      class="mt-8 flex items-center justify-center gap-3"
    >
      <button
        id="prev"
        type="button"
        class="vn-btn vn-btn-raised h-9 px-4 text-sm"
      >
        <span aria-hidden="true">←</span> Prev
      </button>
      <span id="pageinfo" class="min-w-32 text-center text-sm text-muted-foreground">Page 1 of 1</span>
      <button
        id="next"
        type="button"
        class="vn-btn vn-btn-raised h-9 px-4 text-sm"
      >
        Next <span aria-hidden="true">→</span>
      </button>
    </nav>
  </section>
</Base>

<script>
  const PAGE_SIZE = 24;

  const q = document.getElementById("q") as HTMLInputElement;
  const state = document.getElementById("state") as HTMLSelectElement;
  const probono = document.getElementById("probono") as HTMLInputElement;
  const count = document.getElementById("count") as HTMLElement;
  const empty = document.getElementById("empty") as HTMLElement;
  const results = document.getElementById("results") as HTMLElement;
  const pager = document.getElementById("pager") as HTMLElement;
  const prevBtn = document.getElementById("prev") as HTMLButtonElement;
  const nextBtn = document.getElementById("next") as HTMLButtonElement;
  const pageInfo = document.getElementById("pageinfo") as HTMLElement;
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".org-card"));
  const nf = new Intl.NumberFormat();

  let matches: HTMLElement[] = cards; // cards passing the current filter
  let page = 1; // 1-based, within the filtered set

  function matchesFilter(card: HTMLElement, term: string, st: string, pb: boolean) {
    const matchesTerm =
      !term ||
      (card.dataset.name ?? "").includes(term) ||
      (card.dataset.city ?? "").includes(term);
    const matchesState = !st || card.dataset.state === st;
    const matchesPb = !pb || card.dataset.probono === "1";
    return matchesTerm && matchesState && matchesPb;
  }

  // Show only the current page's slice of the filtered set; hide everything else.
  function render() {
    const total = matches.length;
    const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
    page = Math.min(Math.max(page, 1), totalPages);

    const start = (page - 1) * PAGE_SIZE;
    const end = start + PAGE_SIZE;
    const onPage = new Set(matches.slice(start, end));
    for (const card of cards) card.hidden = !onPage.has(card);

    if (total === 0) {
      count.textContent = "No organizations found";
    } else {
      const to = Math.min(end, total);
      count.textContent =
        `Showing ${nf.format(start + 1)}–${nf.format(to)} of ` +
        `${nf.format(total)} organization${total === 1 ? "" : "s"}`;
    }
    empty.hidden = total !== 0;

    // Only surface the pager when there's more than one page to move through.
    if (total > PAGE_SIZE) {
      pager.hidden = false;
      prevBtn.disabled = page <= 1;
      nextBtn.disabled = page >= totalPages;
      pageInfo.textContent = `Page ${nf.format(page)} of ${nf.format(totalPages)}`;
    } else {
      pager.hidden = true;
    }
  }

  // Recompute the filtered set. Any filter change returns to the first page.
  function applyFilter() {
    const term = q.value.trim().toLowerCase();
    const st = state.value;
    const pb = probono.checked;
    matches = cards.filter((card) => matchesFilter(card, term, st, pb));
    page = 1;
    render();
  }

  function goTo(next: number) {
    page = next;
    render();
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    count.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
  }

  let raf = 0;
  const schedule = () => {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(applyFilter);
  };
  q.addEventListener("input", schedule);
  state.addEventListener("change", applyFilter);
  probono.addEventListener("change", applyFilter);
  prevBtn.addEventListener("click", () => goTo(page - 1));
  nextBtn.addEventListener("click", () => goTo(page + 1));

  // Activate pagination now that JS is running (no-JS users keep the full list).
  applyFilter();
</script>
