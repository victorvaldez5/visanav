---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found — VisaNav" description="The page you're looking for doesn't exist.">
  <section class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="text-sm font-semibold text-link">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-foreground">
      We couldn't find that page
    </h1>
    <p class="mt-3 text-muted-foreground">
      The page may have moved. Try the directory or start a free chat.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="bg-primary px-5 py-3 text-base font-semibold text-primary-foreground shadow-sm transition-opacity hover:opacity-90">Go home</a>
      <a href="/directory" class="border border-border bg-surface px-5 py-3 text-base font-semibold text-foreground shadow-sm transition-colors hover:bg-surface-muted">Find help</a>
    </div>
  </section>
</Base>
