---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found — VisaNav" description="The page you're looking for doesn't exist.">
  <section class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="font-serif text-6xl font-bold text-vn-ocean-700">404</p>
    <h1 class="mt-2 text-3xl font-bold text-foreground">
      We couldn't find that page
    </h1>
    <p class="mt-3 text-muted-foreground">
      The page may have moved. Try the directory or start a free chat.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="vn-btn vn-btn-primary h-12 px-6 text-base">Go home</a>
      <a href="/directory" class="vn-btn vn-btn-raised h-12 px-6 text-base">Find help</a>
    </div>
  </section>
</Base>
