---
import Base from "../../layouts/Base.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import { TURNSTILE_SITE_KEY } from "../../config";
import { isLocale, DEFAULT_LOCALE, useTranslations } from "../../i18n";

// One file serves every locale: `/partners` and `/es/partners`.
export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: "es" } }];
}
const lang = Astro.params.lang;
const locale = isLocale(lang) ? lang : DEFAULT_LOCALE;
const t = useTranslations(locale);

const US_STATES = [
  "AL","AK","AZ","AR","CA","CO","CT","DE","DC","FL","GA","HI","ID","IL","IN",
  "IA","KS","KY","LA","ME","MD","MA","MI","MN","MS","MO","MT","NE","NV","NH",
  "NJ","NM","NY","NC","ND","OH","OK","OR","PA","RI","SC","SD","TN","TX","UT",
  "VT","VA","WA","WV","WI","WY","PR","GU","VI",
];

const inputClass = "vn-field mt-2 h-10 px-3 text-sm";
const labelClass = "block text-sm font-medium leading-none text-foreground";
---

<Base title={t("partners.title")} description={t("partners.description")} canonicalPath="/partners">
  <section
    class="mx-auto max-w-3xl px-4 py-14 sm:px-6"
    id="partners-page"
    data-strings={JSON.stringify({
      locale,
      submit: t("partners.submit"),
      submitting: t("partners.submitting"),
      errCaptcha: t("partners.errCaptcha"),
      errTooMany: t("partners.errTooMany"),
      errGeneric: t("partners.errGeneric"),
      errNetwork: t("partners.errNetwork"),
    })}
  >
    <Eyebrow items={t.list("partners.eyebrow")} />

    <h1 class="mt-5 text-4xl font-bold text-foreground">
      {t("partners.h1")}
    </h1>
    <p class="mt-3 leading-relaxed text-muted-foreground">
      {t("partners.intro")}
    </p>

    <!-- Success panel (revealed after submit) -->
    <div id="success" hidden class="vn-card mt-8 p-6">
      <div class="flex items-start gap-3">
        <span aria-hidden="true" class="mt-1.5 h-2.5 w-2.5 shrink-0 rotate-45 bg-vn-sunflower-400"></span>
        <div>
          <h2 class="text-lg font-bold text-foreground">{t("partners.successTitle")}</h2>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            {t("partners.successBody")}
          </p>
        </div>
      </div>
    </div>

    <form id="partner-form" class="vn-card mt-8 space-y-6 p-6 sm:p-8" novalidate>
      <!-- Honeypot: hidden from people, catnip for bots. Do not remove. -->
      <div aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;height:0;overflow:hidden;">
        <label>{t("partners.honeypot")}
          <input type="text" name="hp_website" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <div>
        <label for="organization_name" class={labelClass}>{t("partners.orgName")} <span class="text-link">*</span></label>
        <input id="organization_name" name="organization_name" type="text" required class={inputClass} />
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label for="contact_name" class={labelClass}>{t("partners.contactName")}</label>
          <input id="contact_name" name="contact_name" type="text" autocomplete="name" class={inputClass} />
        </div>
        <div>
          <label for="contact_email" class={labelClass}>{t("partners.contactEmail")} <span class="text-link">*</span></label>
          <input id="contact_email" name="contact_email" type="email" required autocomplete="email" class={inputClass} />
        </div>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label for="contact_phone" class={labelClass}>{t("partners.phone")}</label>
          <input id="contact_phone" name="contact_phone" type="tel" autocomplete="tel" class={inputClass} />
        </div>
        <div>
          <label for="website" class={labelClass}>{t("partners.website")}</label>
          <input id="website" name="website" type="url" placeholder="https://…" class={inputClass} />
        </div>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label for="city" class={labelClass}>{t("partners.city")}</label>
          <input id="city" name="city" type="text" class={inputClass} />
        </div>
        <div>
          <label for="state" class={labelClass}>{t("partners.state")}</label>
          <select id="state" name="state" class={inputClass}>
            <option value="">{t("partners.select")}</option>
            {US_STATES.map((s) => <option value={s}>{s}</option>)}
          </select>
        </div>
      </div>

      <fieldset>
        <legend class={labelClass}>{t("partners.intentLegend")}</legend>
        <div class="mt-3 space-y-3">
          <label class="flex items-start gap-3.5 rounded-[8px] bg-background p-4">
            <input type="radio" name="intent" value="listing" checked class="mt-1 h-[18px] w-[18px] accent-vn-ocean-700" />
            <span class="text-sm leading-relaxed text-muted-foreground">
              <strong class="block font-serif text-base font-bold text-foreground">{t("partners.intentListingTitle")}</strong>
              {t("partners.intentListingBody")}
            </span>
          </label>
          <label class="flex items-start gap-3.5 rounded-[8px] bg-background p-4">
            <input type="radio" name="intent" value="partner" class="mt-1 h-[18px] w-[18px] accent-vn-ocean-700" />
            <span class="text-sm leading-relaxed text-muted-foreground">
              <strong class="block font-serif text-base font-bold text-foreground">{t("partners.intentPartnerTitle")}</strong>
              {t("partners.intentPartnerBody")}
            </span>
          </label>
        </div>
      </fieldset>

      <label class="flex items-center gap-2.5 text-sm font-medium text-foreground">
        <input type="checkbox" name="offers_pro_bono" class="h-[18px] w-[18px] accent-vn-ocean-700" />
        {t("partners.proBono")}
      </label>

      <div>
        <label for="message" class={labelClass}>{t("partners.message")}</label>
        <textarea id="message" name="message" rows="4" class="vn-field mt-2 px-3 py-2.5 text-sm leading-5"></textarea>
      </div>

      <!-- Cloudflare Turnstile: a privacy-friendly CAPTCHA. It drops a hidden
           `cf-turnstile-response` input into this form; the API verifies it. -->
      <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="auto"></div>

      <div id="error" hidden role="alert" class="rounded-[4px] bg-destructive/10 px-4 py-3 text-sm text-destructive-foreground"></div>

      <button
        id="submit"
        type="submit"
        class="vn-btn vn-btn-primary h-12 px-6 text-base"
      >
        {t("partners.submit")}
      </button>
      <p class="text-xs leading-relaxed text-muted-foreground">
        {t("partners.fineprint")}
      </p>
    </form>

    <!-- is:inline so Astro leaves this third-party loader untouched; it
         implicit-renders the .cf-turnstile widget above on load. -->
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </section>
</Base>

<script>
  import { SUBMISSIONS_ENDPOINT, TURNSTILE_SITE_KEY } from "../../config";

  // Copy for the strings this script writes, rendered per locale at build time.
  const strings = JSON.parse(document.getElementById("partners-page")!.dataset.strings ?? "{}");

  const form = document.getElementById("partner-form") as HTMLFormElement;
  const success = document.getElementById("success") as HTMLElement;
  const errorBox = document.getElementById("error") as HTMLElement;
  const submitBtn = document.getElementById("submit") as HTMLButtonElement;

  // Turnstile tokens are single-use; refresh the widget after any failed attempt.
  const resetTurnstile = () => (window as any).turnstile?.reset?.();

  function showError(msg: string) {
    errorBox.textContent = msg;
    errorBox.hidden = false;
    errorBox.scrollIntoView({ behavior: "smooth", block: "center" });
  }

  // Turn a DRF 400 body ({field: ["msg"], ...}) into one readable line.
  function formatErrors(data: unknown): string {
    if (data && typeof data === "object") {
      const parts: string[] = [];
      for (const [k, v] of Object.entries(data as Record<string, unknown>)) {
        const msg = Array.isArray(v) ? v.join(" ") : String(v);
        parts.push(k === "detail" || k === "non_field_errors" ? msg : `${k}: ${msg}`);
      }
      if (parts.length) return parts.join("  ");
    }
    return strings.errGeneric;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorBox.hidden = true;

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const fd = new FormData(form);
    const turnstileToken = (fd.get("cf-turnstile-response") as string) || "";

    // Turnstile usually solves silently on load; if it hasn't yet, ask the
    // user to wait rather than submitting a request the API will reject.
    if (TURNSTILE_SITE_KEY && !turnstileToken) {
      showError(strings.errCaptcha);
      return;
    }

    const payload: Record<string, unknown> = {
      organization_name: fd.get("organization_name"),
      contact_name: fd.get("contact_name") || "",
      contact_email: fd.get("contact_email"),
      contact_phone: fd.get("contact_phone") || "",
      website: fd.get("website") || "",
      city: fd.get("city") || "",
      state: fd.get("state") || "",
      offers_pro_bono: fd.get("offers_pro_bono") === "on",
      intent: fd.get("intent") || "listing",
      message: fd.get("message") || "",
      hp_website: fd.get("hp_website") || "",
      turnstile_token: turnstileToken,
    };

    submitBtn.disabled = true;
    submitBtn.textContent = strings.submitting;
    try {
      const res = await fetch(SUBMISSIONS_ENDPOINT, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
          // So the API's validation errors come back in the page's language.
          "Accept-Language": strings.locale,
        },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        form.hidden = true;
        success.hidden = false;
        success.scrollIntoView({ behavior: "smooth", block: "center" });
        return;
      }
      resetTurnstile(); // any non-2xx consumed the token; get a fresh one
      if (res.status === 429) {
        showError(strings.errTooMany);
      } else {
        let data: unknown = null;
        try {
          data = await res.json();
        } catch {
          /* non-JSON error */
        }
        showError(formatErrors(data));
      }
    } catch {
      resetTurnstile();
      showError(strings.errNetwork);
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = strings.submit;
    }
  });
</script>
