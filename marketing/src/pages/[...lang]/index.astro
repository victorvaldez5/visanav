---
import Base from "../../layouts/Base.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import { APP_URL, appLink } from "../../config";
import orgs from "../../data/organizations.json";
import { isLocale, DEFAULT_LOCALE, localePath, useTranslations } from "../../i18n";

// One file serves every locale: `/` and `/es/` (see astro.config.mjs i18n).
export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: "es" } }];
}
const lang = Astro.params.lang;
const locale = isLocale(lang) ? lang : DEFAULT_LOCALE;
const t = useTranslations(locale);

const total = orgs.length;
const proBono = orgs.filter((o) => o.proBono).length;
const states = new Set(orgs.map((o) => o.state).filter(Boolean)).size;

const steps = t.items<{ title: string; body: string }>("home.how.steps");
const trust = t.list("home.trust");

// The privacy promises below map to real features: client-side PII scrubbing
// that runs in the browser before a message is sent (frontend/src/lib/pii.ts),
// anonymous chat (no account) with the client IP never stored, conversations
// encrypted at rest with retention limits, and account/data erasure (right to
// delete). Keep the copy in step with what the app does — in particular, the
// scrubber strips identifiers (A-numbers, receipt/case numbers, SSNs, emails,
// phones, addresses, dates), but NOT names, so don't claim otherwise here.
// (Copy lives in src/i18n/<locale>.json under home.privacy.items; icons are by
// position.)
const privacyIcons = ["scrub", "user", "lock", "shield"];
const privacy = t
  .items<{ title: string; body: string }>("home.privacy.items")
  .map((item, i) => ({ ...item, icon: privacyIcons[i] }));
const partnerCards = t.items<{ title: string; body: string }>("home.partners.cards");

// The directory band's figures, bolded inside the translated sentence.
const strong = (n: string | number) => `<strong class="font-bold text-vn-white">${n}</strong>`;
const bandBody = t("home.band.body", {
  total: strong(total.toLocaleString(locale)),
  proBono: strong(proBono),
  states: strong(states),
});
---

<Base title={t("home.title")} description={t("home.description")}>
  <!-- Hero -->
  <section id="top" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="flex flex-col gap-14 lg:flex-row lg:items-start lg:gap-16">
      <div class="lg:max-w-[620px] lg:shrink-0">
        <Eyebrow items={t.list("home.eyebrow")} />

        <h1 class="mt-6 text-4xl font-bold leading-[1.08] text-foreground sm:text-5xl sm:leading-[1.04]">
          {t("home.h1")}
        </h1>

        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted-foreground">
          {t("home.lead")}
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={appLink(locale)} class="vn-btn vn-btn-primary h-12 px-6 text-base">{t("home.ctaChat")}</a>
          <a href={localePath(locale, "/directory")} class="vn-btn vn-btn-raised h-12 px-6 text-base">{t("home.ctaFind")}</a>
        </div>

        <ul class="mt-8 flex flex-col gap-y-2.5 text-sm text-muted-foreground sm:flex-row sm:flex-wrap sm:gap-x-7">
          {
            trust.map((t) => (
              <li class="flex items-center gap-2">
                <svg class="h-4 w-4 shrink-0 text-vn-ocean-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7 7a1 1 0 01-1.4 0l-3-3a1 1 0 011.4-1.4L9 11.6l6.3-6.3a1 1 0 011.4 0z" clip-rule="evenodd" />
                </svg>
                {t}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Chat teaser card -->
      <div class="vn-card w-full p-6 sm:p-8 lg:flex-1">
        <div class="flex items-center gap-2">
          <svg class="h-5 w-auto text-vn-ocean-700" viewBox="0 0 1223.75 1264.94" aria-hidden="true">
            <polygon points="611.88 0 328.37 275.09 328.37 275.21 611.88 517.33 895.39 275.21 895.39 275.09 611.88 0" fill="var(--vn-sunflower-500)" />
            <polygon points="895.51 275.09 895.39 275.09 895.39 275.21 611.88 992.46 328.37 275.21 328.37 275.09 328.24 275.09 0 57 469.75 1264.94 611.88 1264.94 754 1264.94 1223.75 57 895.51 275.09" fill="currentColor" />
          </svg>
          <span class="text-sm font-semibold tracking-tight text-foreground">VisaNav</span>
        </div>

        <h2 class="mt-5 text-2xl font-bold text-foreground">{t("home.teaser.title")}</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          {t("home.teaser.body")}
        </p>

        <form action={APP_URL} method="get" class="mt-6">
          <input type="hidden" name="lang" value={locale} />
          <label for="q" class="block text-sm font-medium text-foreground">{t("home.teaser.label")}</label>
          <input
            id="q"
            name="q"
            type="text"
            placeholder={t("home.teaser.placeholder")}
            class="vn-field mt-2 h-11 px-3 text-base"
          />
          <button type="submit" class="vn-btn vn-btn-primary mt-4 h-11 w-full text-[15px]">
            {t("home.teaser.submit")}
          </button>
        </form>

        <div class="mt-6">
          <Eyebrow
            items={t.list("home.teaser.eyebrow")}
            class="!text-muted-foreground"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <div class="flex flex-col gap-10 lg:flex-row lg:gap-24">
      <div class="lg:w-[396px] lg:shrink-0">
        <h2 class="text-3xl font-bold text-foreground">{t("home.how.title")}</h2>
        <p class="mt-4 leading-relaxed text-muted-foreground">
          {t("home.how.body")}
        </p>
      </div>

      <ol class="flex-1">
        {
          steps.map((s, i) => (
            <li class="flex gap-5">
              <div class="flex w-4 shrink-0 flex-col items-center">
                <span
                  aria-hidden="true"
                  class:list={[
                    "mt-2 h-3 w-3 shrink-0 rotate-45",
                    i === 0 ? "bg-vn-sunflower-400" : "bg-vn-ocean-300",
                  ]}
                />
                {i < steps.length - 1 && (
                  <span aria-hidden="true" class="mt-2.5 w-0.5 flex-1 bg-vn-ocean-100" />
                )}
              </div>
              <div class:list={[i < steps.length - 1 && "pb-8"]}>
                <h3 class="text-lg font-bold text-foreground">{s.title}</h3>
                <p class="mt-1 text-[15px] leading-relaxed text-muted-foreground">{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Privacy -->
  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <h2 class="text-3xl font-bold text-foreground">{t("home.privacy.title")}</h2>
    <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
      {t("home.privacy.intro")}
    </p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        privacy.map((p) => (
          <div class="vn-card p-7">
            <svg class="h-6 w-6 text-vn-ocean-700" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              {p.icon === "scrub" && (
                <path fill-rule="evenodd" d="M15.53 3.53a2.5 2.5 0 0 1 3.54 0l1.4 1.4a2.5 2.5 0 0 1 0 3.54l-9.3 9.3a1 1 0 0 1-.7.3H7a1 1 0 0 1-1-1v-3.47a1 1 0 0 1 .3-.7l9.23-9.37Zm-6.2 15.47a1 1 0 0 1 1-1H21a1 1 0 1 1 0 2h-9.67a1 1 0 0 1-1-1Zm4.79-13.06-6.12 6.2V16h1.86l6.18-6.18-1.92-2.88Zm3.32 1.48.72-.72a.5.5 0 0 0 0-.71l-1.4-1.41a.5.5 0 0 0-.72 0l-.73.73 2.13 2.11Z" clip-rule="evenodd" />
              )}
              {p.icon === "user" && (
                <>
                  <path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z" />
                  <path d="M12 14c-4.42 0-8 2.24-8 5v1a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-1c0-2.76-3.58-5-8-5Z" />
                </>
              )}
              {p.icon === "lock" && (
                <path fill-rule="evenodd" d="M7 10V7a5 5 0 0 1 10 0v3h1a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h1Zm2 0h6V7a3 3 0 0 0-6 0v3Z" clip-rule="evenodd" />
              )}
              {p.icon === "shield" && (
                <path d="M12 2 4 5v6c0 4.97 3.4 9.44 8 10.75C16.6 20.44 20 15.97 20 11V5l-8-3Zm3.7 7.3a1 1 0 0 1 0 1.4l-4 4a1 1 0 0 1-1.4 0l-2-2a1 1 0 1 1 1.4-1.4l1.3 1.29 3.3-3.29a1 1 0 0 1 1.4 0Z" />
              )}
            </svg>
            <h3 class="mt-4 text-lg font-bold text-foreground">{p.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted-foreground">{p.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Directory band -->
  <section class="bg-band text-band-foreground">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between sm:gap-12">
        <div class="max-w-3xl">
          <h2 class="text-3xl font-bold text-vn-white">{t("home.band.title")}</h2>
          <p class="mt-3 leading-relaxed text-band-muted" set:html={bandBody} />
        </div>
        <a href={localePath(locale, "/directory")} class="vn-btn vn-btn-secondary h-12 shrink-0 px-6 text-base">
          {t("home.band.cta")}
        </a>
      </div>
    </div>
  </section>

  <!-- For organizations -->
  <section id="partners" class="bg-surface-muted">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <div class="flex flex-col gap-10 lg:flex-row lg:items-center lg:gap-24">
        <div class="lg:w-[520px] lg:shrink-0">
          <Eyebrow items={t.list("home.partners.eyebrow")} />
          <h2 class="mt-5 text-3xl font-bold text-foreground">
            {t("home.partners.title")}
          </h2>
          <p class="mt-3 leading-relaxed text-muted-foreground">
            {t("home.partners.body")}
          </p>
          <a href={localePath(locale, "/partners")} class="vn-btn vn-btn-raised mt-7 h-12 px-6 text-base">
            {t("home.partners.cta")}
          </a>
        </div>

        <ul class="flex flex-1 flex-col gap-4">
          {
            partnerCards.map((c) => (
              <li class="vn-card flex items-start gap-4 p-6">
                <span aria-hidden="true" class="mt-[11px] h-2.5 w-2.5 shrink-0 rotate-45 bg-vn-sunflower-400" />
                <div>
                  <h3 class="text-lg font-bold text-foreground">{c.title}</h3>
                  <p class="mt-1 text-[15px] leading-relaxed text-muted-foreground">{c.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>
