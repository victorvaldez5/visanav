---
import { DEFAULT_LOCALE, localePath, useTranslations } from "../i18n";
import type { Locale } from "../i18n";
import Logo from "./Logo.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
// The legal pages are English only (an unreviewed machine translation of legal
// text would be worse than none), so they stay on the bare URLs in every locale
// and are labelled as such outside English.
const legalNote = locale === DEFAULT_LOCALE ? "" : ` (${t("footer.englishOnly")})`;
const link = "text-vn-ocean-100 transition-colors hover:text-vn-white";
---

<footer class="bg-band text-band-foreground">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="flex flex-col gap-10 sm:flex-row sm:justify-between">
      <div class="max-w-sm">
        <Logo class="text-vn-ocean-50" diamond="var(--vn-sunflower-400)" />
        <p class="mt-4 text-sm leading-relaxed text-band-muted">
          {t("footer.tagline")}
        </p>
      </div>

      <nav
        aria-label={t("layout.footerNav")}
        class="grid grid-cols-2 gap-x-16 gap-y-3 text-sm"
      >
        <a href={localePath(locale, "/")} class={link}>{t("nav.home")}</a>
        <a href={localePath(locale, "/directory")} class={link}>{t("nav.findHelp")}</a>
        <a href={localePath(locale, "/partners")} class={link}>{t("nav.forOrgs")}</a>
        <a href={localePath(locale, "/directory")} class={link}>{t("footer.directory")}</a>
        <a href={localePath(DEFAULT_LOCALE, "/terms")} class={link}>{t("footer.terms")}{legalNote}</a>
        <a href={localePath(DEFAULT_LOCALE, "/privacy")} class={link}>{t("footer.privacy")}{legalNote}</a>
      </nav>
    </div>

    <div class="mt-10 max-w-3xl text-xs leading-relaxed">
      <p class="text-[13px] font-bold leading-5 text-vn-white">
        {t("footer.notLawFirm")}
      </p>
      <p class="mt-1.5 text-band-muted">
        {t("footer.disclaimer")}
      </p>
      <p class="mt-5 text-vn-ocean-300">{t("footer.copyright", { year })}</p>
    </div>
  </div>
</footer>
