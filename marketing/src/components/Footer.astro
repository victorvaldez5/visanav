---
import Logo from "./Logo.astro";
const year = new Date().getFullYear();
---

<footer class="bg-band text-band-foreground">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="flex flex-col gap-10 sm:flex-row sm:justify-between">
      <div class="max-w-sm">
        <Logo class="text-vn-ocean-50" diamond="var(--vn-sunflower-400)" />
        <p class="mt-4 text-sm leading-relaxed text-band-muted">
          A free, public-interest tool that helps immigrants understand their
          options and find trustworthy, low-cost help.
        </p>
      </div>

      <nav
        aria-label="Footer"
        class="grid grid-cols-2 gap-x-16 gap-y-3 text-sm"
      >
        <a href="/" class="text-vn-ocean-100 transition-colors hover:text-vn-white">Home</a>
        <a href="/directory" class="text-vn-ocean-100 transition-colors hover:text-vn-white">Find help</a>
        <a href="/partners" class="text-vn-ocean-100 transition-colors hover:text-vn-white">For organizations</a>
        <a href="/directory" class="text-vn-ocean-100 transition-colors hover:text-vn-white">Resource directory</a>
      </nav>
    </div>

    <div class="mt-10 max-w-3xl text-xs leading-relaxed">
      <p class="text-[13px] font-bold leading-5 text-vn-white">
        VisaNav is not a law firm and does not provide legal advice.
      </p>
      <p class="mt-1.5 text-band-muted">
        Information here is general and may not fit your situation. Always
        confirm with a qualified, accredited representative or attorney before
        acting. VisaNav is free — no one should ever ask you to pay to use it.
      </p>
      <p class="mt-5 text-vn-ocean-300">&copy; {year} VisaNav. Built as a public good.</p>
    </div>
  </div>
</footer>
