---
// VisaNav lockup: the brand mark (sunflower diamond over an ocean "N") plus the
// wordmark. The "N" half is drawn with `currentColor` so it inherits the
// surrounding text colour — ocean on light surfaces, a pale ocean on the dark
// footer band. The diamond is fixed to sunflower. Matches public/favicon.svg.
interface Props {
  /** Extra classes for the wrapper (sizing, text colour). */
  class?: string;
  /** Tailwind height class for the mark. Defaults to a header-sized mark. */
  markClass?: string;
  /** Render the "VisaNav" wordmark next to the mark. */
  wordmark?: boolean;
  /** Diamond fill. Sunflower-500 on light; footer passes the brighter 400. */
  diamond?: string;
}
const {
  class: cls,
  markClass = "h-7 w-auto",
  wordmark = true,
  diamond = "var(--vn-sunflower-500)",
} = Astro.props;
---

<span class:list={["inline-flex items-center gap-2 font-semibold text-foreground", cls]}>
  <svg
    viewBox="0 0 1223.75 1264.94"
    class:list={[markClass]}
    role="img"
    aria-label="VisaNav"
  >
    <polygon
      points="611.88 0 328.37 275.09 328.37 275.21 611.88 517.33 895.39 275.21 895.39 275.09 611.88 0"
      fill={diamond}
    />
    <polygon
      points="895.51 275.09 895.39 275.09 895.39 275.21 611.88 992.46 328.37 275.21 328.37 275.09 328.24 275.09 0 57 469.75 1264.94 611.88 1264.94 754 1264.94 1223.75 57 895.51 275.09"
      fill="currentColor"
    />
  </svg>
  {wordmark && <span class="text-lg tracking-tight">VisaNav</span>}
</span>
