---
import { appLink } from "../config";
import { DEFAULT_LOCALE, LOCALE_NAMES, SUPPORTED_LOCALES, localePath, useTranslations } from "../i18n";
import type { Locale } from "../i18n";
import Logo from "./Logo.astro";

interface Props {
  locale: Locale;
  /** The current page's locale-free path, e.g. "/directory". */
  path: string;
  /** Whether this page exists in every locale (see Base.astro). */
  translated: boolean;
}
const { locale, path, translated } = Astro.props;
const t = useTranslations(locale);

const nav = [
  { href: localePath(locale, "/"), match: "/", label: t("nav.home") },
  { href: localePath(locale, "/directory"), match: "/directory", label: t("nav.findHelp") },
  { href: localePath(locale, "/partners"), match: "/partners", label: t("nav.forOrgs") },
];
const isActive = (match: string) => (match === "/" ? path === "/" : path.startsWith(match));
const chatHref = appLink(locale);

// The language link: the same page in the other locale, or that locale's home
// when this page has no translation (terms, privacy are English only).
const other = SUPPORTED_LOCALES.find((l) => l !== locale) ?? DEFAULT_LOCALE;
const otherHref = localePath(other, translated ? path : "/");
---

<header class="sticky top-0 z-40 bg-card/95 shadow-[var(--elevation-1)] backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href={localePath(locale, "/")} aria-label={t("layout.homeLabel")} class="flex items-center gap-2.5">
      <Logo />
      <span
        class="vn-badge vn-badge-diamond h-5 px-3 text-[11px] leading-none"
      >
        {t("layout.beta")}
      </span>
    </a>

    <!-- Desktop nav -->
    <nav aria-label={t("layout.primaryNav")} class="hidden items-center gap-1 sm:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.match) ? "page" : undefined}
            class:list={[
              "flex items-center gap-2 px-3 py-2 text-sm transition-colors",
              isActive(item.match)
                ? "font-semibold text-foreground"
                : "font-medium text-muted-foreground hover:text-foreground",
            ]}
          >
            {isActive(item.match) && (
              <span
                aria-hidden="true"
                class="h-[7px] w-[7px] rotate-45 bg-vn-sunflower-400"
              />
            )}
            {item.label}
          </a>
        ))
      }
      <a
        href={otherHref}
        hreflang={other}
        lang={other}
        class="ml-1 px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
        >{LOCALE_NAMES[other]}</a
      >
      <a href={chatHref} class="vn-btn vn-btn-primary ml-1 h-9 px-4 text-sm">
        {t("nav.startChat")}
      </a>
    </nav>

    <!-- Mobile menu: a native disclosure so it works without JS. -->
    <details class="vn-menu relative sm:hidden">
      <summary
        class="vn-btn vn-btn-raised grid h-11 w-11 cursor-pointer list-none place-items-center [&::-webkit-details-marker]:hidden"
        aria-label={t("layout.openMenu")}
      >
        <svg width="18" height="14" viewBox="0 0 18 14" fill="currentColor" aria-hidden="true">
          <rect x="0" y="0" width="18" height="2"></rect>
          <rect x="0" y="6" width="18" height="2"></rect>
          <rect x="0" y="12" width="18" height="2"></rect>
        </svg>
      </summary>
      <div
        class="vn-card absolute right-0 top-[calc(100%+0.5rem)] z-50 flex w-56 flex-col gap-1 p-2"
      >
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.match) ? "page" : undefined}
              class:list={[
                "rounded-[4px] px-3 py-2 text-sm transition-colors",
                isActive(item.match)
                  ? "bg-accent font-semibold text-accent-foreground"
                  : "font-medium text-muted-foreground hover:bg-accent hover:text-accent-foreground",
              ]}
            >
              {item.label}
            </a>
          ))
        }
        <a
          href={otherHref}
          hreflang={other}
          lang={other}
          class="rounded-[4px] px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
        >
          {LOCALE_NAMES[other]}
        </a>
        <a href={chatHref} class="vn-btn vn-btn-primary mt-1 h-10 px-4 text-sm">
          {t("nav.startChat")}
        </a>
      </div>
    </details>
  </div>
</header>

<script>
  // Close the mobile disclosure on outside click or Escape.
  const menu = document.querySelector<HTMLDetailsElement>(".vn-menu");
  if (menu) {
    document.addEventListener("click", (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.open) menu.open = false;
    });
  }
</script>
