---
import { APP_URL } from "../config";
import Logo from "./Logo.astro";

const nav = [
  { href: "/", label: "Home" },
  { href: "/directory", label: "Find help" },
  { href: "/partners", label: "For organizations" },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="sticky top-0 z-40 bg-card/95 shadow-[var(--elevation-1)] backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" aria-label="VisaNav home" class="flex items-center gap-2.5">
      <Logo />
      <span
        class="vn-badge vn-badge-diamond h-5 px-3 text-[11px] leading-none"
      >
        BETA
      </span>
    </a>

    <!-- Desktop nav -->
    <nav aria-label="Primary" class="hidden items-center gap-1 sm:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "flex items-center gap-2 px-3 py-2 text-sm transition-colors",
              isActive(item.href)
                ? "font-semibold text-foreground"
                : "font-medium text-muted-foreground hover:text-foreground",
            ]}
          >
            {isActive(item.href) && (
              <span
                aria-hidden="true"
                class="h-[7px] w-[7px] rotate-45 bg-vn-sunflower-400"
              />
            )}
            {item.label}
          </a>
        ))
      }
      <a href={APP_URL} class="vn-btn vn-btn-primary ml-2 h-9 px-4 text-sm">
        Start free chat
      </a>
    </nav>

    <!-- Mobile menu: a native disclosure so it works without JS. -->
    <details class="vn-menu relative sm:hidden">
      <summary
        class="vn-btn vn-btn-raised grid h-11 w-11 cursor-pointer list-none place-items-center [&::-webkit-details-marker]:hidden"
        aria-label="Open menu"
      >
        <svg width="18" height="14" viewBox="0 0 18 14" fill="currentColor" aria-hidden="true">
          <rect x="0" y="0" width="18" height="2"></rect>
          <rect x="0" y="6" width="18" height="2"></rect>
          <rect x="0" y="12" width="18" height="2"></rect>
        </svg>
      </summary>
      <div
        class="vn-card absolute right-0 top-[calc(100%+0.5rem)] z-50 flex w-56 flex-col gap-1 p-2"
      >
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "rounded-[4px] px-3 py-2 text-sm transition-colors",
                isActive(item.href)
                  ? "bg-accent font-semibold text-accent-foreground"
                  : "font-medium text-muted-foreground hover:bg-accent hover:text-accent-foreground",
              ]}
            >
              {item.label}
            </a>
          ))
        }
        <a href={APP_URL} class="vn-btn vn-btn-primary mt-1 h-10 px-4 text-sm">
          Start free chat
        </a>
      </div>
    </details>
  </div>
</header>

<script>
  // Close the mobile disclosure on outside click or Escape.
  const menu = document.querySelector<HTMLDetailsElement>(".vn-menu");
  if (menu) {
    document.addEventListener("click", (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.open) menu.open = false;
    });
  }
</script>
