---
import { APP_URL } from "../config";
import Logo from "./Logo.astro";

const nav = [
  { href: "/", label: "Home" },
  { href: "/directory", label: "Find help" },
  { href: "/partners", label: "For organizations" },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header
  class="sticky top-0 z-40 border-b border-border bg-surface/90 backdrop-blur"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" aria-label="VisaNav home" class="flex items-center gap-2">
      <Logo />
      <span class="border border-vn-orange-200 bg-vn-orange-50 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-vn-orange-800">Beta</span>
    </a>

    <nav aria-label="Primary" class="flex items-center gap-1 sm:gap-2">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "hidden px-3 py-2 text-sm font-medium transition-colors sm:inline-block",
              isActive(item.href)
                ? "text-link"
                : "text-muted-foreground hover:text-foreground",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={APP_URL}
        class="bg-primary px-3.5 py-2 text-sm font-semibold text-primary-foreground shadow-sm transition-opacity hover:opacity-90"
      >
        Start free chat
      </a>
    </nav>
  </div>
</header>
